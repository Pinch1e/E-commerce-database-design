Table Customer {
  CustomerID int [pk]
  Name varchar
  Email varchar
  PhoneNumber varchar
}

Table Order {
  OrderID int [pk]
  OrderDate date
  OrderStatus varchar
  TotalAmount decimal
  CustomerID int [ref: > Customer.CustomerID, not null]
}

Table Category {
  CategoryID int [pk]
  CategoryName varchar
  Description varchar
}

Table Product {
  ProductID int [pk]
  ProductName varchar
  Description varchar
  Price decimal
  CategoryID int [ref: > Category.CategoryID, not null]
}

Table ShippingAddress {
  AddressID int [pk]
  CustomerID int [ref: > Customer.CustomerID, not null]
  Street varchar
  City varchar
  PostalCode varchar
  Country varchar
}

Table OrderItem {
  OrderItemID int [pk]
  OrderID int [ref: > Order.OrderID, not null]
  ProductID int [ref: > Product.ProductID, not null]
  Quantity int
}

Table ShoppingCart {
  CartID int [pk]
  CustomerID int [ref: > Customer.CustomerID, not null]
  CreatedDate date
  CartStatus varchar
}

Table CartItem {
  CartItemID int [pk]
  CartID int [ref: > ShoppingCart.CartID, not null]
  ProductID int [ref: > Product.ProductID, not null]
  Quantity int
}

Table Inventory {
  InventoryID int [pk]
  ProductID int [ref: > Product.ProductID, not null]
  QuantityInStock int
  ReorderLevel int
  LastUpdated date
}
